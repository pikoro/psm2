{% extends 'base/layout.html.twig' %}

{% block title %} - {{ 'profile.edit' | trans }}{% endblock %}

{% block breadcrumb_items %}
    <a href="/profile/{{ user_id }}">{{ 'profile.view_profile' | trans }}</a>
    <span class="current">{{ 'profile.edit' | trans }}</span>
{% endblock %}

{% block content %}
<div class="form-page">
    <h2>{{ 'profile.edit' | trans }}</h2>
    <form method="POST" action="/profile/edit" class="form">
        {{ csrf_token|raw }}
        <div class="form-group">
            <label for="first_name">{{ 'profile.first_name' | trans }}</label>
            <input type="text" id="first_name" name="first_name" value="{{ old.first_name ?? user.first_name ?? '' }}" maxlength="100">
        </div>
        <div class="form-group">
            <label for="last_name">{{ 'profile.last_name' | trans }}</label>
            <input type="text" id="last_name" name="last_name" value="{{ old.last_name ?? user.last_name ?? '' }}" maxlength="100">
        </div>
        <div class="form-group">
            <label for="username">{{ 'profile.username' | trans }}</label>
            <input type="text" id="username" name="username" value="{{ old.username ?? user.username }}" required maxlength="50">
            {% if validation_errors.username %}<span class="error">{{ validation_errors.username }}</span>{% endif %}
        </div>
        <div class="form-group">
            <label for="email">{{ 'profile.email' | trans }}</label>
            <input type="email" id="email" name="email" value="{{ old.email ?? user.email }}" required>
            {% if validation_errors.email %}<span class="error">{{ validation_errors.email }}</span>{% endif %}
        </div>
        <div class="form-group">
            <label for="paypal_email">{{ 'profile.paypal_email' | trans }}</label>
            <input type="email" id="paypal_email" name="paypal_email" value="{{ old.paypal_email ?? user.paypal_email ?? '' }}">
        </div>
        <div class="form-group">
            <label for="bio">{{ 'profile.bio' | trans }}</label>
            <textarea id="bio" name="bio" rows="4" maxlength="1000">{{ old.bio ?? user.bio ?? '' }}</textarea>
        </div>
        <div class="form-group">
            <label for="language">{{ 'profile.language' | trans }}</label>
            <select id="language" name="language">
                {% for code, name in supported_locales %}
                    <option value="{{ code }}" {{ current_locale == code ? 'selected' : '' }}>{{ name }}</option>
                {% endfor %}
            </select>
            <small>{{ 'profile.language_help' | trans }}</small>
        </div>
        <button type="submit" class="btn btn-primary">{{ 'profile.save' | trans }}</button>
        <a href="/profile/{{ user_id }}" class="btn btn-secondary">{{ 'profile.cancel' | trans }}</a>
    </form>
</div>
{% endblock %}
