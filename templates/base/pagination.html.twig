{% if pagination.total > pagination.per_page %}
<div class="pagination">
    {% set page = pagination.page %}
    {% set total_pages = (pagination.total + pagination.per_page - 1) // pagination.per_page %}

    {% if page > 1 %}
        <a href="{{ pagination.base_url }}&page=1" class="page-link">&laquo; First</a>
        <a href="{{ pagination.base_url }}&page={{ page - 1 }}" class="page-link">&lsaquo; Prev</a>
    {% endif %}

    {% for i in max(1, page - 2)..min(total_pages, page + 2) %}
        <a href="{{ pagination.base_url }}&page={{ i }}" class="page-link {{ i == page ? 'active' : '' }}">{{ i }}</a>
    {% endfor %}

    {% if page < total_pages %}
        <a href="{{ pagination.base_url }}&page={{ page + 1 }}" class="page-link">Next &rsaquo;</a>
        <a href="{{ pagination.base_url }}&page={{ total_pages }}" class="page-link">Last &raquo;</a>
    {% endif %}
</div>
{% endif %}
