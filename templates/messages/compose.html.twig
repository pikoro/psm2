{% extends 'base/layout.html.twig' %}

{% block title %} - Compose Message{% endblock %}

{% block breadcrumb_items %}
    <a href="/messages/inbox">Messages</a>
    <span class="current">Compose</span>
{% endblock %}

{% block content %}
<div class="form-page">
    <h2>Compose Message</h2>
    <form method="POST" action="/messages/compose" class="form">
        {{ csrf_token|raw }}
        <div class="form-group">
            <label for="to_user_id">To</label>
            <select id="to_user_id" name="to_user_id" required>
                <option value="">Select recipient</option>
                {% if to_user %}
                    <option value="{{ to_user.id }}" selected>{{ to_user.username }}</option>
                {% endif %}
            </select>
        </div>
        <div class="form-group">
            <label for="subject">Subject</label>
            <input type="text" id="subject" name="subject" value="{{ default_subject ?? '' }}" required maxlength="255">
        </div>
        <div class="form-group">
            <label for="body">Message</label>
            <textarea id="body" name="body" rows="10" required>{{ default_body ?? '' }}</textarea>
        </div>
        <button type="submit" class="btn btn-primary">Send</button>
        <a href="/messages/inbox" class="btn btn-secondary">Cancel</a>
    </form>
</div>
{% endblock %}
