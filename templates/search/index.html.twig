{% extends 'base/layout.html.twig' %}

{% block title %} - Search: {{ keyword }}{% endblock %}

{% block breadcrumb_items %}
    <a href="/browse">Browse</a>
    <span class="current">Search: {{ keyword }}</span>
{% endblock %}

{% block content %}
<div class="search-page">
    <h2>Search Results for "{{ keyword }}"</h2>
    <form method="GET" action="/search" class="search-form">
        <input type="text" name="q" value="{{ keyword }}" placeholder="Search items..." required>
        <button type="submit" class="btn btn-primary">Search</button>
    </form>

    {% if items|length > 0 %}
    <p class="results-count">{{ items|length }} result{{ items|length != 1 ? 's' : '' }} found</p>
    <div class="item-grid">
        {% for item in items %}
        <div class="item-card">
            <a href="/items/{{ item.id }}">
                <div class="item-image">
                    {% if item.main_photo %}
                        <img src="/uploads/{{ item.main_photo }}" alt="{{ item.name }}" loading="lazy">
                    {% else %}
                        <div class="no-image">No Photo</div>
                    {% endif %}
                </div>
                <div class="item-info">
                    <h3>{{ item.name|slice(0, 40) }}{% if item.name|length > 40 %}...{% endif %}</h3>
                    <p class="item-price">{{ item.price ? item.price ~ ' ' ~ item.currency : 'Free' }}</p>
                    <span class="item-category">{{ item.category_name ?? 'Uncategorized' }}</span>
                </div>
            </a>
        </div>
        {% endfor %}
    </div>
    {% include 'base/pagination.html.twig' %}
    {% else %}
    <p class="no-results">No results found for "{{ keyword }}".</p>
    <p>Try different keywords or <a href="/browse">browse all items</a>.</p>
    {% endif %}
</div>
{% endblock %}
