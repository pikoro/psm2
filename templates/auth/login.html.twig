{% extends 'base/layout.html.twig' %}

{% block title %} - {{ 'auth.login' | trans }}{% endblock %}

{% block breadcrumb_items %}
    <span class="current">{{ 'auth.login' | trans }}</span>
{% endblock %}

{% block content %}
<div class="auth-form">
    <h2>{{ 'auth.login' | trans }}</h2>
    <form method="POST" action="/login" class="form">
        {{ csrf_token|raw }}
        <div class="form-group">
            <label for="username">{{ 'auth.username' | trans }}</label>
            <input type="text" id="username" name="username" value="{{ old.username ?? '' }}" required autofocus>
        </div>
        <div class="form-group">
            <label for="password">{{ 'auth.password' | trans }}</label>
            <input type="password" id="password" name="password" required>
        </div>
        <button type="submit" class="btn btn-primary btn-full">{{ 'auth.submit_login' | trans }}</button>
    </form>
    <div class="auth-links">
        <a href="/forgot-password">{{ 'auth.forgot_password' | trans }}</a>
        <span>or</span>
        <a href="/register">{{ 'auth.create_account' | trans }}</a>
    </div>
</div>
{% endblock %}
